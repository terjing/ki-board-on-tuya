{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Keyboard Companion",
  "version": "0.1.0",
  "identifier": "com.kiro.agentic.keyboard.companion",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run typecheck && npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentic Keyboard Companion",
        "width": 980,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"]
  }
}
